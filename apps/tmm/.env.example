# ==============================================================================
# TERRACEFERI - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Bu dosyayı .env olarak kopyalayın ve sunucu değerlerinize göre doldurun:
# cp .env.example .env

# --- SUNUCU & ÇALIŞMA AYARLARI ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- UYGULAMA ALAN ADI / URL ---
# Nginx arkasındaki canlı domain (HTTPS zorunlu)
NEXT_PUBLIC_APP_URL="https://terraceferi.codapi.site"
APP_URL="https://terraceferi.codapi.site"

# --- GÜVENLİK & JWT ---
# Güçlü, rastgele en az 32 karakterlik bir anahtar belirleyin:
# openssl rand -base64 32
JWT_SECRET="degistirin-super-gizli-jwt-anahtari-production-icin-en-az-32-karakter"

# --- VERİTABANI (POSTGRESQL) ---
# Tekil PostgreSQL veritabanı kullanmak için aşağıdaki tek satır yeterlidir:
DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi?schema=public&sslmode=prefer"

# İsteğe bağlı: Modül bazlı ayrı veritabanları kullanılacaksa aşağıdaki değişkenler tanımlanabilir.
# Tanımlanmazlarsa hepsi otomatik olarak DATABASE_URL değerini kullanır.
# CORE_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_core?schema=public"
# AREA_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_area?schema=public"
# EQUIPMENT_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_equipment?schema=public"
# COMPANY_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_company?schema=public"
# FAULT_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_fault?schema=public"
# APARTMENT_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_apartment?schema=public"
# PERSONNEL_DATABASE_URL="postgresql://terraceferi_user:GucluSifre123!@127.0.0.1:5432/terraceferi_personnel?schema=public"

# --- İSTEĞE BAĞLI ENTEGRASYONLAR ---
# GROQ_API_KEY="gsk_..."
# WHATSAPP_PHONE="905305631781"
