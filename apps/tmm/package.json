{
  "name": "tmm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "whatsapp:bot": "node scripts/whatsapp-bot-server.js",
    "build": "npm run prisma:generate && next build",
    "start": "node scripts/start-server.js",
    "start:next": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema=modules/core/database/schema.prisma && prisma generate --schema=modules/area/database/schema.prisma && prisma generate --schema=modules/apartment/database/schema.prisma && prisma generate --schema=modules/company/database/schema.prisma && prisma generate --schema=modules/equipment/database/schema.prisma && prisma generate --schema=modules/fault/database/schema.prisma && prisma generate --schema=modules/personnel/database/schema.prisma",
    "db:generate": "npm run prisma:generate",
    "db:push": "node scripts/db-push-all.js",
    "db:seed": "node scripts/seed-admin.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "whatsapp-web.js": "^1.34.7",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@prisma/client": "^5.21.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.21.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
