generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma-clients/apartment"
}

datasource db {
  provider = "postgresql"
  url      = env("APARTMENT_DATABASE_URL")
}

model Apartment {
  id            String   @id @default(uuid())
  block         String   // A Blok, B Blok vb.
  unit          String   // A1, B12 vb.
  shortCode     String   // 241, 300 vb.
  residentName  String   // Sakin Adı Soyadı
  status        String   // Mülk Sahibi, Kiracı, Boş
  floor         String   // -1, 0, 1, 2 vb.
  type          String   // 2+1, 3+1 vb.
  
  // İletişim & Plakalar
  phone         String?
  plate1        String?
  plate2        String?
  plate3        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}
